<?xml version="1.0"?>
<extension key="pulse" type="module">
  <file>pulse</file>
  <name>Pulse</name>
  <description>Token-protected health-check endpoint for CiviCRM (civicrm/pulse). Reports database and cron health as JSON for uptime monitors like Uptime Kuma, Nagios or Icinga. Works on Standalone, Drupal and WordPress.</description>
  <license>AGPL-3.0-or-later</license>
  <authors>
    <author>
      <name>Johannes Filter (civico GmbH)</name>
      <email>johannes@civico.de</email>
      <role>Maintainer</role>
    </author>
  </authors>
  <urls>
    <url desc="Main Extension Page">https://github.com/civico-de/pulse</url>
    <url desc="Documentation">https://civico-de.github.io/pulse/</url>
    <url desc="Support">https://github.com/civico-de/pulse/issues</url>
    <url desc="Licensing">http://www.gnu.org/licenses/agpl-3.0.html</url>
  </urls>
  <releaseDate>2026-10-26</releaseDate>
  <version>0.10.2</version>
  <develStage>beta</develStage>
  <compatibility>
    <ver>6.12</ver>
  </compatibility>
  <php_compatibility mode="list">
    <ver>8.2</ver>
    <ver>8.3</ver>
    <ver>8.4</ver>
  </php_compatibility>
  <classloader>
    <psr0 prefix="CRM_" path="."/>
    <psr4 prefix="Civi\" path="Civi"/>
  </classloader>
  <civix>
    <namespace>CRM/Pulse</namespace>
    <format>25.10.2</format>
    <angularModule>crmPulse</angularModule>
  </civix>
  <mixins>
    <mixin>mgd-php@2.0.0</mixin>
    <mixin>scan-classes@1.0.0</mixin>
    <mixin>menu-xml@1.0.0</mixin>
    <mixin>setting-php@1.0.0</mixin>
    <mixin>smarty@1.0.3</mixin>
  </mixins>
  <upgrader>CRM_Pulse_Upgrader</upgrader>
</extension>
