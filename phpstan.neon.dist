parameters:
	level: 10
	phpVersion: 80200
	# PHPDoc array shapes (APIv4 rows, decoded JSON) describe what the data
	# IS, but defensive runtime checks (is_array on decoded JSON) must not be
	# reported as redundant because of them. Also: PEAR-era signatures lie in
	# their PHPDocs (a documented "array" can be a PEAR_Error).
	treatPhpDocTypesAsCertain: false
	# A typed property with no default is a runtime Error waiting for the one
	# path that reads it before writing it; APIv4 action parameters are exempt.
	checkUninitializedProperties: true
	# The whole repository, so a directory added later is analysed without an
	# edit here; phpstan has no optional entries in paths.
	paths:
		- .
	excludePaths:
		analyse:
			# civix-generated; BAO/ is not — civix only seeds it, the logic is the repo's
			- CRM/*/DAO/*
			- pulse.civix.php
			- mixin (?)
			# phpstan-tests.neon.dist analyses the suite in a second pass
			- tests (?)
		analyseAndScan:
			- phpstanBootstrap.php
			# ckdeps config; its analyser classes exist only in the image's toolbelt
			- composer-dependency-analyser.php
			- vendor (?)
			- node_modules (?)
			- build (?)
			- .civikitchen-siblings (?)
	scanFiles:
		- pulse.civix.php
	scanDirectories:
		# Core ships APIv4 entities from its bundled extensions, not only from
		# Civi/Api4 proper — Civi\Api4\Contribution lives in civi_contribute,
		# MailingJob in civi_mail. Without this every call on such an entity is
		# class.notFound and the whole fluent chain after it degrades to mixed.
		- /var/www/html/core/ext
	bootstrapFiles:
		- phpstanBootstrap.php
	# ignoreErrors: only ever narrowly scoped (identifier + path + count) and
	# carrying a comment that says WHY the report is wrong — never blanket
	# patterns, never a baseline file.
	ignoreErrors:
		-
			# Surfacing the failure IS the job of a health check: it becomes the
			# endpoint's 503, not a substituted value some caller mistakes for data.
			identifier: ck.db.silentCatch
			path: Civi/Pulse/HealthEndpoint.php
			# The rule ships with civikitchen 1.7.0; unmatched until then.
			reportUnmatched: false
